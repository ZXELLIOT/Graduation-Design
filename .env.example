# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值（.env 已被 .gitignore 排除）
# ============================================================

# --- AI 增强配置（方舟 Ark API）---
# 是否默认开启 AI 增强（0=关闭, 1=开启）
AI_ENHANCED_DEFAULT=0

# API Key（必填，否则 AI 增强不可用）
ARK_API_KEY=your_api_key_here

# 模型名称
ARK_MODEL_NAME=Doubao1.5-vision-pro

# API 地址
ARK_RESPONSES_URL=https://ark.cn-beijing.volces.com/api/v3/responses

# 请求超时时间（秒）
ARK_TIMEOUT_SEC=20

# AI 融合候选数量
AI_ENHANCE_TOPK=5

# --- 内网穿透配置 ---
# 是否自动启动 cloudflared 隧道（0=关闭, 1=开启）
AUTO_TUNNEL_ENABLED=0

# 隧道代理目标地址
TUNNEL_LOCAL_URL=http://127.0.0.1:7860
